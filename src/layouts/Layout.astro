---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BottomBar from '../components/BottomBar.astro';

export interface Props {
	title: string;
    description: string,
    robots: string,
}

const { title,description, robots } = Astro.props;
