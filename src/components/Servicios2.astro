---
<div id="cards-stack" class="w-full max-w-6xl mx-auto px-4 py-4">
  {cards.map((card, i) => (
    <div class="card-slot" data-index={i}>
      <div class="card-inner group">
        <!-- Image -->
        <div class="card-image-wrap">
          <img src={card.img} alt={card.section} class="card-image" />
        </div>
        <!-- Content -->
        <div class="card-content">
          <div class="flex gap-3 items-start">
            <Fragment set:html={card.svg} />
            <h4 class="text-xl font-bold text-[#002149] group-hover:text-primary transition-colors duration-300 leading-snug">
              {card.title}
            </h4>
          </div>
          <p class="mt-4 text-[#16263a] text-base leading-relaxed text-left">
            {card.description}
          </p>
        </div>
      </div>
    </div>
  ))}
</div>
 
<script>
(function () {
  const TOP_OFFSET = 160; // navbar height + spacing
  const STACK_GAP  = 0;   // px each successive card is offset lower
 
  function init() {
    const stack = document.getElementById('cards-stack');
    if (!stack) return;
 
    const slots  = Array.from(stack.querySelectorAll('.card-slot'));
    const inners = slots.map(s => s.querySelector('.card-inner'));
 
    // Step 1: Temporarily reset all slots to auto height so the inner cards
    // can render at their natural size (important on mobile where cards are
    // taller due to flex-direction:column).
    slots.forEach(slot => {
      slot.style.height = 'auto';
      slot.style.marginBottom = '2.5rem';
    });
 
    // Step 2: Measure each card's real rendered height and lock the slot to
    // that exact value. This is the scroll "room" the card occupies.
    function syncSlotHeights() {
      // Reset to auto first so we get the true natural height
      inners.forEach(inner => {
        inner.style.position = '';
        inner.style.width    = '';
        inner.style.top      = '';
        inner.style.left     = '';
      });
      slots.forEach((slot, i) => {
        const h = inners[i].getBoundingClientRect().height;
        slot.style.height = h + 'px';
      });
    }
 
    syncSlotHeights();
 
    function update() {
      const stackRect = stack.getBoundingClientRect();
 
      slots.forEach((slot, i) => {
        const inner     = inners[i];
        const cardH     = slot.getBoundingClientRect().height; // locked height
        const stickyTop = TOP_OFFSET + i * STACK_GAP;
        const slotRect  = slot.getBoundingClientRect();
        const naturalTop = slotRect.top;
 
        if (naturalTop <= stickyTop && stackRect.bottom > stickyTop + cardH) {
          // PIN
          inner.style.position = 'fixed';
          inner.style.top      = stickyTop + 'px';
          inner.style.left     = slotRect.left + 'px';
          inner.style.width    = slotRect.width + 'px';
          inner.style.zIndex   = String(10 + i);
        } else {
          // FLOW
          inner.style.position = 'relative';
          inner.style.top      = '';
          inner.style.left     = '';
          inner.style.width    = '';
          inner.style.zIndex   = String(10 + i);
        }
      });
    }
 
    // On resize: re-measure heights then re-run pinning logic
    window.addEventListener('resize', () => {
      syncSlotHeights();
      update();
    }, { passive: true });
 
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
 
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
 
<style>
  /* Each slot is a block placeholder — gives the page its scroll height */
  .card-slot {
    position: relative;
  }
 
  /* The visual card — starts relative, becomes fixed via JS when pinned */
  .card-inner {
    display: flex;
    overflow: hidden;
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 0 15px #e7e7e7;
    will-change: transform;
    height: 18rem;
    /* width/top/left/position set by JS when pinned */
  }
  .card-image-wrap {
    position: relative;
    width: 35%;
    flex-shrink: 0;
  }
 
  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
 
  .card-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgb(0, 0, 0), transparent);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 1rem 0.75rem 0.5rem;
  }
 
  .card-content {
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow-y: auto;
  }
 
  /* Mobile: simpler stacking, no fixed positioning needed */
  @media (max-width: 640px) {
    .card-inner {
      flex-direction: column;
      height: auto;
    }
 
    .card-image-wrap {
      width: 100%;
      height: 12rem;
    }
 
    .card-content {
      padding: 1.25rem;
    }
  }
</style>