---
import Layout from "../layouts/Layout.astro"
import Button from "../components/Button.astro"
import { getImage } from 'astro:assets';
import ImgTuto from '../assets/tutorial.jpg'
const optimizedBackgroundTuto = await getImage({src: ImgTuto, format: 'webp'})
---

<Layout
title="¡Formulario enviado con éxito!"
robots="noindex,nofollow"
description="¡Gracias, hemos recibido su formulario!"
>
<section class=" min-h-screen py-8 lg:pt-44 lg:pb-28 bg-[url('/Talleres-para-motocicletas-scaled.webp')] bg-cover py-44 relative">
    <div id="overlay-intro" class="absolute z-0 w-full h-full   top-0"></div>
    <div class="relative grid place-content-center place-items-center">
        <h1 class="text-4xl max-w-4xl mx-auto md:text-6xl lg:text-7xl pt-7 text-primary font-bold text-center">¡Gracias por dejar tus datos!    </h1>
        <p class="max-w-md text-xl text-white font-medium text-center pt-3  my-6 md:px-3">¡Gracias por enviarnos sus respuestas! Da clic en la siguiente liga para descargar una demo de nuestro software.    </p>
        <div class="grid mt-4  md:inline-flex gap-4">
        <Button
        href="https://run.okcar.mx/"
        name="Descargar"
        style="py-4 px-6 rounded-xl bg-primary grid lg:inline-flex font-bold text-white hover:bg-primary/80"

        />
        <Button
        href="#etapas"
        name="¿Cómo instalar el programa?"
        style="block text-white font-bold border duration-200 focus-visible:outline-black focus-visible:ring-black focus:outline-none items-center justify-center px-6 rounded-xl text-center inline-flex py-3 hover:text-white bg-transparent  hover:bg-secondary/80"

        />
        </div>
    
    </div>
</section>
<section id="etapas" class="px-6 grid max-w-6xl gap-8 mx-auto md:grid-cols-2 lg:grid-cols-3 py-16">
    <div class="box-learn grid items-start rounded-3xl">
        <div id="box-learn" class="flex flex-col h-full relative">
            <div class="rounded-t-3xl bg-black/90 overflow-hidden py-4 relative bg-center">
                <p id="contrax" class="text-primary text-3xl text-center relative">Paso 1                </p>
            </div>             
            <div class="px-8 py-8 text-center">
                <Button
                href="https://run.okcar.mx/"
                name="Descargar"
                style="py-4 px-6 rounded-xl bg-primary grid lg:inline-flex font-bold text-white hover:bg-primary/80"
        
                />
                <p class="text-xl mt-6">Da clic en el botón superior <b>DESCARGAR</b>, y presiona el botón <b>¨Install¨</b> </p>
            </div>
        </div>
    </div>
    <!--Paso 2 -->
    <div class="box-learn grid items-start rounded-3xl">
        <div id="box-learn" class="flex flex-col h-full relative">
            <div class="rounded-t-3xl bg-black/90 overflow-hidden py-4 relative bg-center">
                <p id="contrax" class="text-primary text-3xl text-center relative">Paso 2               </p>
            </div>             
            <div class="px-8 py-8 grid text-center">
                <img src="/setup.png" width="80px" class="mx-auto mb-4" alt="">
             <p class="text-xl mb-6">Se comenzará a descargar <b>SETUP</b>.
                Una vez finalizada la descarga, encuentralo en tu carpeta de <b>Descargas</b>, y ejecútalo.</p>
            </div>
        </div>
    </div>
    <!--Paso 3 -->
    <div class="box-learn grid items-start rounded-3xl">
        <div id="box-learn" class="flex flex-col h-full relative">
            <div class="rounded-t-3xl bg-black/90 overflow-hidden py-4 relative bg-center">
                <p id="contrax" class="text-primary text-3xl text-center relative">Paso 3               </p>
            </div>             
            <div class="px-8 py-8 grid text-center">
                <img src="/instalar.png" width="80px" class="mx-auto mb-4" alt="">
             <p class="text-xl mb-6">Dale clic a <b>Instalar</b> que aparece en la ventana emergente.

             </p>
            </div>
        </div>
    </div>
    <!--Paso 4 -->
    <div class="box-learn grid items-start rounded-3xl">
        <div id="box-learn" class="flex flex-col h-full relative">
            <div class="rounded-t-3xl bg-black/90 overflow-hidden py-4 relative bg-center">
                <p id="contrax" class="text-primary text-3xl text-center relative">Paso 4               </p>
            </div>             
            <div class="px-8 py-8 grid text-center">
                <img src="/acceso-o-demo.png" width="80px" class="mx-auto mb-4" alt="">
             <p class="text-xl mb-6">En la pantalla de inicio, selecciona <b>CONTINUAR DEMO</b>.


             </p>
            </div>
        </div>
    </div>
    <!--Paso 5 -->
    <div class="box-learn grid items-start rounded-3xl">
        <div id="box-learn" class="flex flex-col h-full relative">
            <div class="rounded-t-3xl bg-black/90 overflow-hidden py-4 relative bg-center">
                <p id="contrax" class="text-primary text-3xl text-center relative">Paso 5               </p>
            </div>             
            <div class="px-8 py-8 grid text-center">
                <img src="/acesso.png" width="80px" class="mx-auto mb-4" alt="">
             <p class="text-xl mb-6">Introduzca los datos de <i>Usuario</i> y <i>Contraseña</i>  para acceder al demo, y de clic en <b>Aceptar</b>.


             </p>
            </div>
        </div>
    </div>
    <!--Paso 5 -->
    <div class="box-learn grid items-start rounded-3xl">
        <div id="box-learn" class="flex flex-col h-full relative">
            <div class="rounded-t-3xl bg-black/90 overflow-hidden py-4 relative bg-center">
                <p id="contrax" class="text-primary text-3xl text-center relative">Datos Acceso
                </p>
            </div>             
            <div class="px-8 py-8 grid text-center ">
             <ul class="text-xl mb-6 grid font-bold  gap-2">
                <li>*</li>
                <li>Usuario: Usuario 1                </li>
                <li>Contraseña: 123                </li>
                <li>*</li>

             </ul>
            </div>
        </div>
    </div>
</section>
</Layout>

<style>

#overlay-intro{
	background: linear-gradient(357deg, rgba(0,0,0,0.1293767507002801) 0%, rgba(0,0,0,0.6251750700280112) 35%, rgba(0,0,0,0.8352591036414566) 61%, rgba(0,0,0,1) 100%);}

    .box-learn{
	transition: transform .35s, box-shadow .35s;
	transform: translate(0);
	box-shadow: 0 20px 34px rgba(44, 11, 11, 0.04), 0 4px 8px rgba(44, 11, 11, 0.02), 0 10px 34px rgba(255, 52, 52, 0.05);
    
}
.box-learn:hover{
	transform: scale(.97);
    box-shadow: 0 5px 18px rgba(44, 11, 11, 0.04), 0 1px 2px rgba(44, 11, 11, 0.02), 0 3px 15px rgba(255, 52, 52, 0.05);
}
</style>