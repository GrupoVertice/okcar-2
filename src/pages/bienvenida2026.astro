<script>
  // Acordeón genérico: una tarjeta abierta a la vez, por grupo (contacto / capacitación).
  const accItems = document.querySelectorAll("[data-acc-toggle]");
  function toggleAcc(item) {
    const group = item.getAttribute("data-acc-group");
    const isOpen = item.getAttribute("aria-expanded") === "true";
    document
      .querySelectorAll('[data-acc-toggle][data-acc-group="' + group + '"]')
      .forEach((el) => el.setAttribute("aria-expanded", "false"));
    item.setAttribute("aria-expanded", isOpen ? "false" : "true");
  }
  accItems.forEach((item) => {
    item.addEventListener("click", () => toggleAcc(item));
    item.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        toggleAcc(item);
      }
    });
  });

  // Animación de entrada al hacer scroll.
  const revealEls = document.querySelectorAll("[data-reveal]");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.05 }
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add("is-visible"));
  }

  // Ajusta el alto del iframe padre (se conserva del original).
  window.onload = function () {
    window.parent.postMessage(document.body.scrollHeight, "*");
  };
</script>