<meta charset="UTF-8" />
<meta name="author" content="Grupo Vértice-Marco Orellana" />
<meta name="robots" content="noindex, nofollow">
<meta name="description" content="OK CAR — Bienvenida" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Gabarito:wght@500;700;800;900&display=swap"
  rel="stylesheet"
/>

<style>
  :root {
    --red: #f3494a;
    --red-dark: #aa0108;
    --red-bg: #2e0a12;
    --navy: #030718;
    --slate: #1c2638;
    --panel-hover: #212c44;
    --border: rgba(255, 255, 255, 0.08);
    --border-strong: rgba(255, 255, 255, 0.16);
    --text: #f4f6fb;
    --muted: #8d96ac;

    /* colores por categoría (capacitación) */
    --c-operativo: var(--red);
    --c-operativo-tint: rgba(243, 73, 74, 0.12);
    --c-operativo-border: rgba(243, 73, 74, 0.4);

    --c-admin: #4f8ff7;
    --c-admin-tint: rgba(79, 143, 247, 0.12);
    --c-admin-border: rgba(79, 143, 247, 0.4);

    --c-posventa: #ec6fb0;
    --c-posventa-tint: rgba(236, 111, 176, 0.12);
    --c-posventa-border: rgba(236, 111, 176, 0.4);

    --c-inventario: #34d399;
    --c-inventario-tint: rgba(52, 211, 153, 0.12);
    --c-inventario-border: rgba(52, 211, 153, 0.4);

    --c-oro: #f5c451;
    --c-oro-tint: rgba(245, 196, 81, 0.12);
    --c-oro-border: rgba(245, 196, 81, 0.4);

    --c-modulos: #8d96ac;
    --c-modulos-tint: rgba(141, 150, 172, 0.12);
    --c-modulos-border: rgba(141, 150, 172, 0.4);

    --c-contacto: #f5c451;
    --c-contacto-tint: rgba(245, 196, 81, 0.12);
    --c-contacto-border: rgba(255, 179, 0, 0.4);

    --c-whatsapp: #25d366;
    --c-whatsapp-tint: rgba(37, 211, 102, 0.12);
    --c-whatsapp-border: rgba(37, 211, 102, 0.45);

    --c-correo: #4f8ff7;
    --c-correo-tint: rgba(79, 143, 247, 0.12);
    --c-correo-border: rgba(79, 143, 247, 0.45);
  }

  .ok-help {
    font-family: "DM Sans", "Helvetica Neue", sans-serif;
    color: var(--text);
    background-image: linear-gradient(180deg, var(--red-bg) 0%, var(--navy) 5%, var(--slate));
    max-width: 2000px;
    margin-inline: auto;
    padding: 3.5rem 6% 5rem;
  }

  .ok-help h1,
  .ok-help h2,
  .ok-help h3 {
    font-family: "Gabarito", "Helvetica Neue", sans-serif;
  }

  /* ---------- eyebrow + heading ---------- */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red);
  }
  .eyebrow::before {
    content: "";
    width: 18px;
    height: 2px;
    background: var(--red);
    border-radius: 2px;
  }
  .section-head h2 {
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    font-weight: 800;
    color: var(--text);
    margin-top: 0.35rem;
  }
  .section-head p {
    color: var(--muted);
    font-size: 0.98rem;
    margin-top: 0.4rem;
    max-width: 46ch;
  }

  /* ---------- columnas independientes ---------- */
  .two-col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }
  @media (min-width: 1024px) {
    .two-col {
      grid-template-columns: 0.6fr 1fr;
      align-items: start;
      gap: 5rem;
    }
  }

  /* ---------- acordeón genérico (contacto + capacitación) ---------- */
  .acc-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .acc-item {
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--slate);
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  .acc-item:hover,
  .acc-item[aria-expanded="true"] {
    background: var(--accent-tint);
    border-color: var(--accent-border);
  }
  .acc-item:focus-visible {
    outline: 2px solid var(--accent, var(--red));
    outline-offset: 2px;
  }
  .acc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    padding: 1rem 1.15rem;
    cursor: pointer;
  }
  .acc-head-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }
  .acc-icon-chip {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: var(--accent-tint);
    color: var(--accent);
  }
  .acc-title {
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--text);
  }
  .acc-chevron {
    flex-shrink: 0;
    color: var(--muted);
    transition: transform 0.3s ease, color 0.3s ease;
  }
  .acc-item[aria-expanded="true"] .acc-chevron {
    transform: rotate(180deg);
    color: var(--accent);
  }
  .acc-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s ease;
  }
  .acc-item[aria-expanded="true"] .acc-panel {
    grid-template-rows: 1fr;
  }
  .acc-panel > div {
    overflow: hidden;
  }
  .acc-panel-inner {
    padding: 0 1.15rem 1.15rem;
    border-top: 1px solid var(--border);
    margin-top: 0.15rem;
    padding-top: 1rem;
  }

  .btn-solid {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    justify-content: center;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.55rem 0.9rem;
    border-radius: 10px;
    background: var(--accent, var(--red));
    color: #0a0e18;
    white-space: nowrap;
    transition: filter 0.2s ease;
  }
  .btn-solid:hover {
    filter: brightness(1.1);
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    justify-content: center;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.55rem 0.9rem;
    border-radius: 10px;
    border: 1px solid var(--border-strong);
    color: var(--text);
    white-space: nowrap;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--accent);
  }

  /* módulos: lista compacta dentro del acordeón */
  .module-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.6rem;
    border-radius: 9px;
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 500;
    transition: background 0.2s ease;
  }
  .module-row:hover {
    background: rgba(255, 255, 255, 0.06);
  }
  .module-row svg {
    flex-shrink: 0;
    color: var(--c-modulos);
  }

  /* ---------- novedades: video + ticket ---------- */
  .video-card {
    display: block;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--border);
    transition: transform 0.35s ease, border-color 0.35s ease;
  }
  .video-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
  }
  .video-card img {
    display: block;
    width: 100%;
    height: auto;
  }

  .ticket-update {
    position: relative;
    border-radius: 20px;
    padding: 1.75rem 1.75rem;
    margin-top: 1.5rem;
    color: white;
    background: linear-gradient(135deg, var(--red), var(--red-dark));
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .badge-nuevo {
    position: absolute;
    top: -14px;
    right: 28px;
    background: linear-gradient(135deg, #fdba3b, #f59e0b);
    color: #241a00;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    box-shadow: 0 6px 16px rgba(245, 158, 11, 0.35);
  }

  /* ---------- separador punteado ---------- */
  .dotted-divider {
    height: 4px;
    margin: 2.75rem 0;
    background-image: radial-gradient(
      circle,
      var(--red) 1.6px,
      transparent 1.8px
    );
    background-size: 14px 4px;
    background-repeat: repeat-x;
    opacity: 0.9;
  }

  /* ---------- ventas: 2x2 ---------- */
  .venta-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.1rem;
  }
  .venta-thumb {
    display: block;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--border);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .venta-thumb:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
  }
  .venta-thumb img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- reveal-on-scroll ---------- */
  .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

