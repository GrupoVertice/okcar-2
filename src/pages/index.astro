/* SWITCH STYLES
–––––––––––––––––––––––––––––––––––––––––––––––––– */
.switch-wrapper {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6px;
  gap: 10px;
  border: 1px solid #d1d5db;
  border-radius:14px;
  background: #fff;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
}

.switch-wrapper [type="radio"] {
  position: absolute;
  left: -9999px;
}

.switch-wrapper [type="radio"]:checked#monthly ~ label[for="monthly"],
.switch-wrapper [type="radio"]:checked#yearly ~ label[for="yearly"],
.switch-wrapper [type="radio"]:checked#months ~ label[for="months"] {
  color: #fff;
}

.switch-wrapper [type="radio"]:checked#monthly ~ label[for="monthly"] .switch-badge,
.switch-wrapper [type="radio"]:checked#yearly ~ label[for="yearly"] .switch-badge,
.switch-wrapper [type="radio"]:checked#months ~ label[for="months"] .switch-badge {
  background: #fff;
  color: #d30a0f;
}

.switch-wrapper [type="radio"]:checked#monthly ~ label[for="monthly"]:hover,
.switch-wrapper [type="radio"]:checked#yearly ~ label[for="yearly"]:hover,
.switch-wrapper [type="radio"]:checked#months ~ label[for="months"]:hover {
  background: transparent;
}

.switch-wrapper [type="radio"]:checked#monthly ~ label[for="monthly"] ~ label[for="months"] ~ label[for="yearly"] ~ .highlighter {
  transform: translateX(0%);
}
.switch-wrapper [type="radio"]:checked#months ~ label[for="monthly"] ~ label[for="months"] ~ label[for="yearly"] ~ .highlighter {
  transform: translateX(101%);
}
.switch-wrapper [type="radio"]:checked#yearly ~ label[for="monthly"] ~ label[for="months"] ~ label[for="yearly"] ~ .highlighter {
  transform: translateX(208%);
}

.switch-wrapper label {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 128px;
  min-height: 56px;
  padding: 10px 14px;
  line-height: 1.1;
  cursor: pointer;
  border-radius: 10px;
  transition: color 0.25s ease-in-out, background-color 0.25s ease-in-out;
}

.switch-wrapper .switch-label {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  text-align: center;
}

.switch-wrapper .switch-title {
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.1;
}

.switch-wrapper .switch-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 2px 8px;
  border-radius: 4px;
  background: #fee2e2;
  color: #b91c1c;
  font-size: 0.75rem;
  font-weight: 600;
  line-height: 1.5;
  white-space: nowrap;
}

.switch-wrapper label:hover {
  background: rgba(211, 10, 15, 0.08);
}

.switch-wrapper .highlighter {
  position: absolute;
  top: 6px;
  left: 6px;
  width: calc(33.33% - 8px);
