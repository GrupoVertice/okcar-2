<script type="text/javascript">

	function showText() {
	  document.getElementById('hover-text').classList.remove('opacity-0');
	  document.getElementById('hover-text').classList.add('opacity-100');
	}
  
	function hideText() {
	  document.getElementById('hover-text').classList.add('opacity-0');
	  document.getElementById('hover-text').classList.remove('opacity-100');
	}
  </script>

