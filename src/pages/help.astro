<style>
*{
    scroll-behavior: smooth;
}
body {    text-align: center;
    font-family:  Gabarito,'Helvetica Neue', sans-serif;
    padding-bottom: 2%;
    background-color: white;
    padding-inline: 10%;
    background-image: linear-gradient(180deg,#ffffff 0%,#ffffff 10%,#ffffff 80%,#e74b4b 100%); 
}

a {
    text-decoration: none;
        font-size: 21px;
}

div.contacto {
    display: grid; 
    padding: 3%;
    padding-top: 0;
    grid-template-columns: 0.9fr 0.16fr 0.16fr 0.16fr 0.16fr; 
    grid-template-rows: 1fr; 
    gap: 0px 10px; 
    grid-template-areas: 
      "t w c l ca"; 
  }

.t {
    grid-area: t;
    text-align: left;
    line-height: 10px;
    padding: 10px;
}


.w {
    grid-area: w;
    padding: 10px;
    text-align: center;
    align-content: center;
    line-height: 30px;
    transition: 0.7s;
    border-radius: 15px;
    svg {
        fill: #3aa71f;
        align-self: center;
        text-align: center;
    }
    h2 {
        color: #212121;
    }
}

.w:hover {
    background-color: #3aa71f;
    box-shadow: 0px 0px 18px#21212152;
    color: whitesmoke;
    svg {
        fill: whitesmoke;
    }
    h2 {
        color: whitesmoke;
    }
}

.c {
    grid-area: c;
    padding: 10px;
    text-align: center;
    align-content: center;
    line-height: 10px;
    transition: 0.7s;
    border-radius: 15px;
    svg {
        fill: #0076c5;
    }
    h2 {
        color: #212121;
    }
}

.c:hover {
    background-color: #0076c5;
    box-shadow: 0px 0px 18px#21212152;
    color: whitesmoke;
    svg {
        fill: whitesmoke;
    }
    h2 {
        color: whitesmoke;
    }
}

.l {
    grid-area: l;
    padding: 10px;
    text-align: center;
    align-content: center;
    line-height: 10px;
    transition: 0.7s;
    border-radius: 15px;
    svg {
        fill: #f5bb1a;
    }
    h2 {
        color: #212121;
    }
}

.l:hover {
    background-color: #f1b819;
    box-shadow: 0px 0px 18px#21212152;
    color: whitesmoke;
    svg {
        fill: whitesmoke;
    }
    h2 {
        color: whitesmoke;
    }
}

.ventas {  
    padding-inline: 2%;
    padding-bottom: 2%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0px 0px;
    grid-auto-flow: row;
    grid-template-areas:
      "t"
      "videos";
  }
  
  .t { grid-area: t; }



iframe {
    height: 170px;
    width: 300px;
}

.cap {
    padding: 6%;
    box-shadow: 0px 0px 18px #21212152;
    transition: 0.5s;
}

    .cap:hover {
        box-shadow: 0px 0px 25px #2121211a;
        scale: 1.05;
    }

  h5 {
    font-size: 20px;
    cursor: pointer;
    margin: 0;
    font-weight: 200;
  }

  .ca {
    grid-area: ca;
    padding: 10px;
    text-align: center;
    align-content: center;
    line-height: 10px;
    transition: 0.7s;
    border-radius: 15px;
    svg {
        fill: #b30000;
    }
    h2 {
        color: #212121;
    }
}

.ca:hover {
    background-color: #b30000;
    box-shadow: 0px 0px 18px#21212152;
    color: whitesmoke;
    svg {
        fill: whitesmoke;
    }
    h2 {
        color: whitesmoke;
    }
}
</style>
